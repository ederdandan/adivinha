[{"n":"Futebol","d":"f","h":["É jogado em equipe.","Cada time tem 11 jogadores.","Não pode usar as mãos, exceto o goleiro.","O objetivo é fazer gol."]},{"n":"Vôlei","d":"f","h":["É jogado em equipe.","Tem uma rede no meio da quadra.","Tem saque, levantamento e cortada.","A bola não pode cair no chão do seu lado."],"a":["Voleibol"]},{"n":"Basquete","d":"f","h":["É jogado em quadra.","Os jogadores costumam ser muito altos.","A bola é quicada no chão.","O objetivo é acertar a cesta."],"a":["Basquetebol"]},{"n":"Natação","d":"f","h":["É um esporte individual.","Usa touca e óculos.","Tem estilos como crawl e borboleta.","É praticado na piscina."]},{"n":"Tênis","d":"f","h":["É jogado com raquete.","A bola é pequena e amarela.","Tem uma rede no meio.","Tem torneios famosos como Wimbledon."]},{"n":"Corrida","d":"f","h":["É um esporte simples.","Precisa só de um bom calçado.","Pode ser de curta ou longa distância.","Vence quem chega primeiro."]},{"n":"Ciclismo","d":"f","h":["É praticado na estrada ou em pista.","Usa capacete.","Tem provas famosas, como o Tour de France.","Usa bicicleta."]},{"n":"Ginástica artística","d":"m","h":["É um esporte olímpico.","Tem trave, barras e solo.","Exige muita flexibilidade.","Os atletas fazem piruetas e saltos."],"a":["Ginástica"]},{"n":"Judô","d":"m","h":["É uma arte marcial japonesa.","Os atletas usam quimono.","A faixa mostra o nível.","O objetivo é derrubar o adversário no tatame."]},{"n":"Boxe","d":"f","h":["É uma luta.","Acontece num ringue.","Usa luvas grandes.","Só vale socar."],"a":["Box"]},{"n":"Surfe","d":"f","h":["É praticado no mar.","Precisa de prancha.","Depende das ondas.","O atleta fica em pé deslizando na onda."],"a":["Surf"]},{"n":"Handebol","d":"m","h":["É jogado em equipe.","Tem gol e goleiro.","A bola é jogada com as mãos.","Parece futebol, mas jogado com as mãos."],"a":["Handball"]},{"n":"Futsal","d":"m","h":["É parecido com o futebol.","É jogado em quadra.","Cada time tem 5 jogadores.","A bola é mais pesada e quica menos."],"a":["Futebol de salão"]},{"n":"Vôlei de praia","d":"m","h":["É jogado na areia.","Cada time tem 2 jogadores.","Os atletas jogam descalços.","Tem uma rede no meio."]},{"n":"Golfe","d":"m","h":["É jogado em grandes gramados.","Usa tacos.","A bolinha é branca.","O objetivo é colocar a bola no buraco com poucas tacadas."],"a":["Golf"]},{"n":"Beisebol","d":"m","h":["É muito popular nos Estados Unidos.","Usa taco e luva.","Tem rebatedor e arremessador.","O jogador corre pelas bases."],"a":["Baseball"]},{"n":"Futebol americano","d":"m","h":["É popular nos Estados Unidos.","Os jogadores usam capacete e ombreiras.","A bola é oval.","Tem a final chamada Super Bowl."]},{"n":"Rúgbi","d":"m","h":["Usa uma bola oval.","É de muito contato.","Não pode passar a bola para a frente com as mãos.","É muito popular na Nova Zelândia."],"a":["Rugby"]},{"n":"Hóquei no gelo","d":"m","h":["É jogado no gelo.","Usa tacos e patins.","O disco é preto.","Os jogadores usam muitas proteções."],"a":["Hóquei"]},{"n":"Patinação no gelo","d":"m","h":["É praticada no gelo.","Usa patins com lâmina.","Tem saltos e piruetas.","É um esporte de inverno elegante."],"a":["Patinação"]},{"n":"Esqui","d":"m","h":["É um esporte de inverno.","É praticado na neve.","Usa bastões.","Desce montanhas com pranchas compridas nos pés."]},{"n":"Capoeira","d":"f","h":["É uma arte brasileira.","Mistura luta, dança e música.","Tem berimbau e roda.","Foi criada por africanos escravizados no Brasil."]},{"n":"Caratê","d":"m","h":["É uma arte marcial japonesa.","Usa quimono e faixa.","Tem golpes de mão e chute.","Tem sequências de movimentos chamadas katas."],"a":["Karatê","Karate"]},{"n":"Esgrima","d":"m","h":["É um esporte de luta.","Os atletas usam roupa branca e máscara.","Usa espada, florete ou sabre.","Ganha ponto quem toca o adversário."]},{"n":"Arco e flecha","d":"m","h":["Exige muita mira.","Tem um alvo com círculos.","Usa uma corda esticada.","Lança flechas."],"a":["Tiro com arco"]},{"n":"Hipismo","d":"m","h":["É um esporte olímpico.","Tem saltos de obstáculos.","O atleta usa capacete e botas.","É praticado montado num cavalo."]},{"n":"Remo","d":"m","h":["É praticado na água.","Usa barcos estreitos.","Os atletas ficam de costas para a chegada.","Usa remos."]},{"n":"Polo aquático","d":"m","h":["É jogado em equipe.","É praticado na piscina.","Tem gols.","Os jogadores não podem tocar no fundo."]},{"n":"Saltos ornamentais","d":"m","h":["É um esporte olímpico.","Tem plataforma e trampolim.","Os atletas fazem piruetas no ar.","Termina com um mergulho na piscina."]},{"n":"Salto com vara","d":"m","h":["É uma prova de atletismo.","O atleta corre com uma vara comprida.","Precisa passar por cima de um sarrafo.","A vara envergada ajuda a subir muito alto."]},{"n":"Maratona","d":"m","h":["É uma corrida muito longa.","Tem cerca de 42 quilômetros.","É inspirada numa lenda grega.","É disputada nas ruas."]},{"n":"Pingue-pongue","d":"f","h":["É jogado numa mesa.","Usa raquetes pequenas.","Tem uma redinha.","A bolinha é leve e branca ou laranja."],"a":["Tênis de mesa","Ping pong"]},{"n":"Badminton","d":"m","h":["É jogado com raquete.","Tem rede.","Usa uma peteca com penas.","É muito popular na Ásia."]},{"n":"Fórmula 1","d":"f","h":["É um esporte de velocidade.","Acontece em autódromos pelo mundo.","Tem paradas nos boxes para trocar pneus.","Os carros têm um lugar só e rodas expostas."],"a":["F1","Automobilismo"]},{"n":"Escalada","d":"m","h":["Exige força e equilíbrio.","Usa cordas e mosquetões.","Pode ser feita em paredes artificiais.","O atleta sobe por rochas e montanhas."],"a":["Alpinismo"]},{"n":"Paraquedismo","d":"m","h":["É um esporte radical.","Começa num avião.","Tem queda livre.","Usa paraquedas."]},{"n":"Triatlo","d":"m","h":["É uma prova de resistência.","Junta três esportes.","Tem natação, ciclismo e corrida.","É feito em sequência, sem parar."],"a":["Triathlon"]},{"n":"Levantamento de peso","d":"m","h":["É um esporte olímpico.","Usa uma barra.","Exige muita força.","O atleta ergu
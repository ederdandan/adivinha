[{"n":"Violão","d":"f","h":["É um instrumento de cordas.","Tem seis cordas.","É de madeira, com um buraco no meio.","É tocado em rodas de amigos e serestas."]},{"n":"Guitarra","d":"f","h":["É um instrumento de cordas.","É elétrica.","Precisa de um amplificador.","É o principal instrumento do rock."]},{"n":"Piano","d":"f","h":["É um instrumento grande.","Tem teclas brancas e pretas.","Tem pedais.","Tem 88 teclas."]},{"n":"Bateria","d":"f","h":["É um instrumento de percussão.","Tem vários tambores e pratos.","É tocada com baquetas.","Tem um bumbo tocado com o pé."]},{"n":"Flauta","d":"f","h":["É um instrumento de sopro.","Tem furinhos.","Muita gente aprende a versão doce na escola.","É fininha e comprida."],"a":["Flauta doce"]},{"n":"Violino","d":"f","h":["É um instrumento de cordas.","É apoiado no ombro e no queixo.","É tocado com arco.","É pequeno e faz parte da orquestra."]},{"n":"Saxofone","d":"m","h":["É um instrumento de sopro.","É dourado e curvo.","É feito de metal.","É muito usado no jazz."],"a":["Sax"]},{"n":"Trompete","d":"m","h":["É um instrumento de sopro.","É de metal dourado.","Tem três pistões.","Toca bem alto, como numa fanfarra."],"a":["Pistom"]},{"n":"Teclado","d":"f","h":["É um instrumento eletrônico.","Tem teclas brancas e pretas.","Liga na tomada.","É parecido com o piano, mas portátil."]},{"n":"Pandeiro","d":"f","h":["É um instrumento de percussão.","É redondo.","Tem platinelas que chacoalham.","É essencial no samba e no chorinho."]},{"n":"Tambor","d":"f","h":["É um instrumento de percussão.","É oco.","Tem uma pele esticada.","É tocado batendo com as mãos ou baquetas."]},{"n":"Triângulo","d":"f","h":["É de metal.","É tocado com uma varetinha.","É essencial no forró.","Tem a forma de uma figura geométrica de três lados."]},{"n":"Sanfona","d":"f","h":["É um instrumento de fole.","Tem teclas e botões.","Abre e fecha para fazer som.","É o instrumento do forró e do baião."],"a":["Acordeão","Gaita"]},{"n":"Cavaquinho","d":"f","h":["É um instrumento de cordas.","É pequeno.","Tem quatro cordas.","É muito tocado no samba e no pagode."],"a":["Cavaco"]},{"n":"Berimbau","d":"m","h":["É um instrumento de uma corda só.","Tem um arco de madeira.","Tem uma cabaça.","É tocado na roda de capoeira."]},{"n":"Harpa","d":"m","h":["É um instrumento de cordas.","É grande.","Tem formato triangular.","É tocada dedilhando muitas cordas com as duas mãos."]},{"n":"Gaita","d":"m","h":["É um instrumento de sopro.","É pequena e cabe no bolso.","Tem furinhos lado a lado.","É muito usada no blues e no country."],"a":["Gaita de boca"]},{"n":"Contrabaixo","d":"m","h":["É um instrumento de cordas.","Faz sons graves.","Costuma ter quatro cordas grossas.","Marca o ritmo junto com a bateria."],"a":["Baixo"]},{"n":"Violoncelo","d":"m","h":["É um instrumento de cordas.","É tocado com arco.","É maior que um violino.","É tocado sentado, apoiado no chão."],"a":["Cello"]},{"n":"Ukulele","d":"m","h":["É um instrumento de cordas.","É pequeno.","Tem quatro cordas.","É do Havaí."]},{"n":"Xilofone","d":"m","h":["É um instrumento de percussão.","Tem plaquinhas de tamanhos diferentes.","É tocado com baquetas.","Muitos brinquedos infantis imitam ele."]},{"n":"Clarinete","d":"m","h":["É um instrumento de sopro.","É preto.","Tem uma palheta.","Toca em orquestras e bandas."],"a":["Clarineta"]},{"n":"Trombone","d":"m","h":["É um instrumento de sopro.","É de metal.","Tem uma vara que desliza.","Faz um som grave."]},{"n":"Tuba","d":"m","h":["É um instrumento de sopro.","É enorme.","É de metal.","Faz o som mais grave da banda."]},{"n":"Cuíca","d":"m","h":["É um instrumento de percussão.","Tem uma vareta presa dentro.","Faz um som parecido com um ronco ou uma risada.","É tocada nas escolas de samba."]},{"n":"Surdo","d":"m","h":["É um instrumento de percussão.","É um tambor grande.","Faz um som grave.","Marca o ritmo das escolas de samba."]},{"n":"Atabaque","d":"m","h":["É um instrumento de percussão.","É um tambor alto e estreito.","É tocado com as mãos.","É usado na capoeira e em cerimônias afro-brasileiras."]},{"n":"Chocalho","d":"f","h":["É um instrumento de percussão.","É balançado com a mão.","Tem grãos ou bolinhas dentro.","Também vira brinquedo de bebê."],"a":["Maraca"]},{"n":"Castanholas","d":"m","h":["É um instrumento de percussão.","É de madeira.","É preso nos dedos.","É usado no flamenco espanhol."]},{"n":"Banjo","d":"m","h":["É um instrumento de cordas.","Tem corpo redondo.","Tem uma pele esticada.","É muito usado no country americano."]},{"n":"Órgão","d":"m","h":["É um instrumento de teclas.","Tem tubos enormes.","É tocado em igrejas.","Usa ar para fazer som."]},{"n":"Agogô","d":"m","h":["É um instrumento de percussão.","É de metal.","Tem dois sininhos de tamanhos diferentes.","É usado no samba."]},{"n":"Tamborim","d":"m","h":["É um instrumento de percussão.","É pequeno.","É tocado com uma baqueta.","Faz parte da bateria da escola de samba."]},{"n":"Viola caipira","d":"m","h":["É um instrumento de cordas.","Tem dez cordas.","É usada na música sertaneja de raiz.","É parente do violão."],"a":["Viola"]},{"n":"Gaita de foles","d":"m","h":["É um instrumento de sopro.","Tem um saco de ar.","Tem vários tubos.","É típica da Escócia."]},{"n":"Bongô","d":"m","h":["É um instrumento de percussão.","São dois tamborzinhos juntos.","É tocado com as mãos.","É comum na música latina."]},{"n":"Pratos","d":"m","h":["São de metal.","São redondos.","Fazem um som estridente.","São batidos um contra o outro."]},{"n":"Apito","d":"f","h":["É pequeno.","Faz um som agudo.","É usado por juízes de futebol.","É soprado."]},{"n":"Sino","d":"f","h":["É de metal.","Badala.","Fica em torres de igreja.","Toca no Natal."]},{"n":"Reco-reco","d":"m","h":["É um instrumento de percussão.","Tem ranhuras.","É raspado com uma vareta.","Faz um som arranhado."]}]
[{"n":"Sol","d":"f","h":["Está no céu.","É muito quente.","Nasce de manhã e se põe à tarde.","É a estrela que ilumina a Terra."]},{"n":"Lua","d":"f","h":["Está no céu.","Muda de fase.","Brilha à noite, refletindo luz.","Os astronautas já pisaram nela."]},{"n":"Estrela","d":"f","h":["Fica no céu.","Aparece à noite.","Parece piscar.","Nos desenhos, tem cinco pontas."]},{"n":"Nuvem","d":"f","h":["Fica no céu.","É branca ou cinza.","É feita de gotinhas de água.","Pode ter formatos que lembram bichos."]},{"n":"Chuva","d":"f","h":["Cai do céu.","Molha tudo.","Enche os rios.","Faz barulho no telhado e forma poças."]},{"n":"Arco-íris","d":"f","h":["Aparece no céu.","Precisa de sol e chuva ao mesmo tempo.","Tem sete cores.","Dizem que tem um pote de ouro no fim."]},{"n":"Relâmpago","d":"f","h":["Aparece no céu.","Acontece em tempestades.","É um clarão rápido.","Vem antes do barulho do trovão."],"a":["Raio"]},{"n":"Vento","d":"f","h":["Não dá para ver.","Balança as árvores.","Faz a pipa voar.","É o ar em movimento."]},{"n":"Neve","d":"f","h":["Cai do céu.","É branca e gelada.","É rara no Brasil.","Dá para fazer bonecos com ela."]},{"n":"Vulcão","d":"f","h":["É uma montanha.","Pode entrar em erupção.","Solta fumaça e cinzas.","Expele lava."]},{"n":"Rio","d":"f","h":["É água doce.","Corre em direção ao mar.","Tem margens.","O Amazonas é um dos maiores."]},{"n":"Mar","d":"f","h":["É enorme.","A água é salgada.","Tem ondas.","Banha as praias."],"a":["Oceano"]},{"n":"Lago","d":"f","h":["Tem água parada.","É cercado de terra.","Tem patos e peixes.","É menor que o mar."],"a":["Lagoa"]},{"n":"Árvore","d":"f","h":["É uma planta grande.","Tem tronco.","Dá sombra.","Tem galhos, folhas e às vezes frutos."]},{"n":"Flor","d":"f","h":["É parte de uma planta.","Tem pétalas.","As abelhas visitam.","É colorida e cheirosa."]},{"n":"Rosa","d":"f","h":["É uma flor.","Tem espinhos.","É símbolo do amor.","É muito dada no Dia dos Namorados."]},{"n":"Girassol","d":"f","h":["É uma flor grande.","É amarela.","Tem sementes que viram petisco.","Gira para acompanhar o sol."]},{"n":"Cacto","d":"f","h":["É uma planta.","Precisa de pouca água.","Vive no deserto e na caatinga.","Tem espinhos."],"a":["Cactus","Mandacaru"]},{"n":"Palmeira","d":"f","h":["É uma árvore.","É alta e fina.","Tem folhas só no topo.","Fica em praias e algumas dão coco."],"a":["Coqueiro"]},{"n":"Folha","d":"f","h":["É parte de uma planta.","É verde.","Faz fotossíntese.","Cai das árvores no outono."]},{"n":"Pedra","d":"f","h":["É dura.","Pode ser grande ou pequena.","Fica no chão.","É feita de minerais."],"a":["Rocha"]},{"n":"Areia","d":"f","h":["É feita de grãozinhos.","Fica na praia e no deserto.","Esquenta no sol.","Dá para fazer castelinhos."]},{"n":"Terremoto","d":"m","h":["É um fenômeno natural.","Faz o chão tremer.","Pode derrubar prédios.","É comum no Japão e no Chile."],"a":["Sismo"]},{"n":"Furacão","d":"m","h":["É um fenômeno natural.","Tem ventos muito fortes.","Se forma sobre o oceano.","Recebe nomes de pessoas."],"a":["Tufão"]},{"n":"Onda","d":"f","h":["Fica no mar.","Vem e vai.","Os surfistas adoram.","Quebra na areia da praia."]},{"n":"Gelo","d":"f","h":["É frio.","Derrete no calor.","É feito no congelador.","É água no estado sólido."]},{"n":"Fogo","d":"f","h":["É quente.","Precisa de oxigênio.","Pode ser perigoso.","Tem chamas."]},{"n":"Orvalho","d":"m","h":["Aparece de manhã cedo.","São gotinhas de água.","Fica nas folhas e na grama.","Se forma com o frio da noite."],"a":["Sereno"]},{"n":"Neblina","d":"m","h":["É uma névoa.","Diminui a visibilidade.","Aparece em manhãs frias.","É como uma nuvem perto do chão."],"a":["Névoa","Cerração"]},{"n":"Granizo","d":"m","h":["Cai do céu.","São bolinhas de gelo.","Pode amassar carros.","Cai durante tempestades."],"a":["Chuva de granizo","Pedra de gelo"]},{"n":"Ipê","d":"m","h":["É uma árvore brasileira.","Floresce no fim do inverno.","Perde as folhas antes de florir.","Tem flores amarelas, roxas ou brancas."]},{"n":"Vitória-régia","d":"m","h":["É uma planta aquática.","Vive na Amazônia.","Tem uma folha redonda enorme.","Sua folha flutua e aguenta bastante peso."]},{"n":"Cogumelo","d":"m","h":["É um fungo.","Cresce em lugares úmidos.","Alguns são comestíveis e outros venenosos.","Tem chapéu e talo."]},{"n":"Grama","d":"f","h":["É uma planta baixa.","Cobre jardins e campos.","É verde.","Precisa ser aparada."],"a":["Gramado"]},{"n":"Semente","d":"f","h":["É pequena.","Fica dentro dos frutos.","Precisa de terra e água.","Dá origem a uma nova planta."]},{"n":"Raiz","d":"m","h":["É parte de uma planta.","Fica debaixo da terra.","Segura a planta.","Absorve água e nutrientes."]},{"n":"Coral","d":"m","h":["Vive no mar.","Parece uma pedra ou planta, mas é animal.","Forma recifes coloridos.","Abriga muitos peixes."]},{"n":"Concha","d":"f","h":["É encontrada na praia.","É dura.","Era a casa de um animal marinho.","Dizem que dá para ouvir o mar nela."]},{"n":"Tsunami","d":"m","h":["É um fenômeno natural.","Começa com um terremoto no mar.","O mar recua antes de chegar.","É uma onda gigante."],"a":["Maremoto"]},{"n":"Pôr do sol","d":"f","h":["Acontece todo dia.","Pinta o céu de laranja e rosa.","Marca o fim da tarde.","É quando o sol desaparece no horizonte."],"a":["Entardecer"]}]